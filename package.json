{
  "name": "next-ui-system",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js App Router 전용 UI 컴포넌트 시스템 — 라이브러리(packages/ui) + API 문서 사이트(apps/docs) 모노레포",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "npm run dev -w docs",
    "build": "npm run build:ui && npm run build:docs",
    "build:ui": "npm run build -w @chansikchoi/next-ui",
    "build:docs": "npm run build -w docs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:pkg": "npm run verify -w @chansikchoi/next-ui",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build:ui && npm run verify:pkg && changeset publish",
    "refs:check": "node scripts/check-refs.mjs",
    "verify:console": "npm run verify:console -w docs",
    "verify:select-rhf": "npm run verify:select-rhf -w docs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
