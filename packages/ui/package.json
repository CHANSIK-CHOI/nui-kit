{
  "name": "@chansikchoi/next-ui",
  "version": "0.0.0",
  "description": "Next.js App Router 전용 React UI 컴포넌트 라이브러리",
  "license": "MIT",
  "author": "CHANSIK-CHOI",
  "keywords": [
    "react",
    "nextjs",
    "app-router",
    "ui",
    "design-system",
    "components"
  ],
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist",
    "styles",
    "README.md",
    "LICENSE",
    "presets.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rhf": {
      "types": "./dist/rhf.d.ts",
      "default": "./dist/rhf.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "default": "./dist/button.js"
    },
    "./field": {
      "types": "./dist/field.d.ts",
      "default": "./dist/field.js"
    },
    "./textfield": {
      "types": "./dist/textfield.d.ts",
      "default": "./dist/textfield.js"
    },
    "./textarea": {
      "types": "./dist/textarea.d.ts",
      "default": "./dist/textarea.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox.d.ts",
      "default": "./dist/checkbox.js"
    },
    "./radio": {
      "types": "./dist/radio.d.ts",
      "default": "./dist/radio.js"
    },
    "./switch": {
      "types": "./dist/switch.d.ts",
      "default": "./dist/switch.js"
    },
    "./popup": {
      "types": "./dist/popup.d.ts",
      "default": "./dist/popup.js"
    },
    "./toast": {
      "types": "./dist/toast.d.ts",
      "default": "./dist/toast.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "default": "./dist/tooltip.js"
    },
    "./accordion": {
      "types": "./dist/accordion.d.ts",
      "default": "./dist/accordion.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "default": "./dist/select.js"
    },
    "./datepicker": {
      "types": "./dist/datepicker.d.ts",
      "default": "./dist/datepicker.js"
    },
    "./icon": {
      "types": "./dist/icon.d.ts",
      "default": "./dist/icon.js"
    },
    "./styles/*.css": "./styles/*.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run build:js && npm run build:styles",
    "build:js": "tsup && tsc -p tsconfig.build.json",
    "build:styles": "node -e \"require('node:fs').rmSync('styles',{recursive:true,force:true})\" && sass --no-source-map --style=compressed --load-path=src/styles src/styles/entries:styles",
    "dev:styles": "sass --watch --no-source-map --load-path=src/styles src/styles/entries:styles",
    "typecheck": "tsc --noEmit",
    "verify": "npm run verify:css && npm run verify:tokens && publint --strict && attw --pack . --profile esm-only",
    "prepublishOnly": "npm run build",
    "verify:css": "node scripts/check-css-isolation.mjs",
    "verify:tokens": "node scripts/check-token-layers.mjs",
    "color:presets": "node scripts/color/build-presets.mjs",
    "color:generate": "node scripts/color/generate.mjs",
    "color:verify": "node scripts/color/verify.mjs"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": ">=7.50.0"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.36.0",
    "lucide-react": "^1.39.0",
    "react-day-picker": "^9.14.0",
    "react-select": "^5.10.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@radix-ui/colors": "^3.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "next": "16.3.2",
    "publint": "0.3.24",
    "radix-theme-generator": "^0.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.71.2",
    "sass": "1.103.1",
    "tsup": "8.5.1",
    "typescript": "7.0.2"
  }
}
